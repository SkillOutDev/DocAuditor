@startuml DocAuditorClassDiagram

title DocAuditor konceptinio lygmens UML klasių diagrama

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class User {
  -username: String
  -email: String
  -passwordHash: String
  +register()
  +login(credentials: LoginCredentials): AuthenticationSession
  +authenticate(credentials: LoginCredentials): Boolean
  +logout()
}

class AuthenticationSession {
  -sessionId: String
  -createdAt: DateTime
  -expiresAt: DateTime
  -status: AuthenticationStatus
  +isActive(): Boolean
}

class LoginCredentials <<structured>> {
  -email: String
  -password: String
  +validate(): Boolean
}

class Document {
  -id: Integer
  -title: String
  -originalFilename: String
  -fileSize: Integer
  -contentType: String
  -createdAt: DateTime
  -updatedAt: DateTime
  -analysisStatus: AnalysisStatus
  -analysisError: String
  +upload(file: DocumentFile)
  +save()
  +delete()
  +preview(): DocumentFile
}

class DocumentFile <<structured>> {
  -path: String
  -format: DocumentFormat
  -size: Integer
  +validate(): Boolean
  +getExtension(): String
}

class DocumentCollection {
  -documents: List<Document>
  +listDocuments(): List<Document>
  +add(document: Document)
  +findById(id: Integer): Document
  +compare(first: Document, second: Document)
}

class DocumentAnalysis <<structured>> {
  -simplifiedExplanation: String
  -analyzedAt: DateTime
  -analysisError: String
  +generate(document: Document): DocumentAnalysis
  +save(document: Document)
  +downloadPdf(): File
}

class RiskAssessment <<structured>> {
  -level: RiskLevel
  -category: String
  -explanation: String
  -clause: String
  +isHighPriority(): Boolean
  +displayLabel(): String
}

class PrivacyAssessment <<structured>> {
  -collectedData: String
  -purposes: String
  -retention: String
  -thirdParties: String
  -eeaTransfer: Boolean
  -marketingWithoutConsent: Boolean
  -summary: String
  +hasWarnings(): Boolean
  +getWarnings(): List<String>
  +displaySummary(): String
}

class KeyCondition <<structured>> {
  -text: String
  -importance: Integer
  +isImportant(): Boolean
  +displayText(): String
}

interface AIProvider {
  +generate(prompt: String): String
  +isAvailable(): Boolean
}

class GeminiProvider {
  -model: String
  +initialize(apiKey: String)
  +generate(prompt: String): String
  +isAvailable(): Boolean
}

class OllamaProvider {
  -baseUrl: String
  -model: String
  +initialize(baseUrl: String, model: String)
  +generate(prompt: String): String
  +isAvailable(): Boolean
}

enum AnalysisStatus {
  PENDING
  ANALYZING
  COMPLETED
  FAILED
}

enum DocumentFormat {
  PDF
  DOC
  DOCX
}

enum AuthenticationStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

User "1" -- "0..*" Document : owns >
User "1" -- "0..*" AuthenticationSession : starts >
AuthenticationSession "1" *-- "1" LoginCredentials : uses >
DocumentCollection "1" o-- "0..*" Document : contains >
Document "1" *-- "1" DocumentFile : stores >
Document "1" *-- "0..1" DocumentAnalysis : has saved >
DocumentAnalysis "1" *-- "0..*" RiskAssessment : identifies >
DocumentAnalysis "1" *-- "1" PrivacyAssessment : evaluates >
DocumentAnalysis "1" *-- "0..*" KeyCondition : extracts >
Document "1" --> "1" AnalysisStatus : has status >
DocumentFile "1" --> "1" DocumentFormat : has format >
AuthenticationSession "1" --> "1" AuthenticationStatus : has status >
RiskAssessment "1" --> "1" RiskLevel : has level >
DocumentAnalysis ..> AIProvider : requests summary, risk and privacy analysis >
AIProvider <|.. GeminiProvider
AIProvider <|.. OllamaProvider

note right of Document
  Pagrindinė sistemos domeno klasė.
  Atitinka backend/api/models.py
  Document modelį.
end note

note right of DocumentAnalysis
  Konceptinė struktūros klasė.
  Duomenys saugomi Document laukuose:
  simplified_explanation,
  risk_assessment,
  privacy_assessment,
  key_conditions.
  Analizė išsaugoma tik vartotojui
  paspaudus „Išsaugoti analizę“.
end note

note bottom of PrivacyAssessment
  Privatumo vertinimas apima renkamus
  duomenis, naudojimo tikslus, saugojimo
  terminą, trečiąsias šalis ir įspėjimus.
end note

note bottom of AIProvider
  Gemini naudojamas kaip pagrindinis,
  Ollama – kaip atsarginis analizės teikėjas.
  Atitinka backend/api/ai.py klases.
end note

note bottom of RiskLevel
  Rizikos sąraše naudojama tvarka:
  HIGH, MEDIUM, LOW.
end note

@enduml
